    "cost",
    "mcp",
    "prompt",
    "ci",
    "finops"
  ],
  "homepage": "https://shekath.github.io/Tokenlens/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shekath/Tokenlens.git",
