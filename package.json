{
  "name": "tokenticks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Token and cost analytics for LLM prompts, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p cli/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "billing-preflight": "node scripts/billing-preflight.mjs",
    "cli:build": "node cli/build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "gpt-tokenizer": "^4.0.0",
    "jspdf": "^4.2.1",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zod": "^4.6.5"
  }
}
